*.py[cod]
.pytest_cache/
.pytest_tmp/
.coverage
htmlcov/
*.egg-info/
build/
dist/
.DS_Store
Thumbs.db
.idea/
.vscode/
data/index/*
!data/index/.gitkeep
data/cache/*
